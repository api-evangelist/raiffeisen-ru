      "description": "prev"
    },
    {
      "url": "https://ecom-test-int-balancer.raiffeisen.ru/adm",
      "description": "test"
    },
    {
      "url": "https://ecom-int-balancer.raiffeisen.ru/adm",
      "description": "prod"
    }
  ],
  "tags": [
    {
      "name": "code-blocking",
      "x-displayName": "Блокировка кода",
      "description": "<div align=center><a href='images/adm-code-blocking.svg' target='_blank'><img src='images/adm-code-blocking.svg' width='600'></a></div>\n"
    },
    {
      "name": "payer-email-change",
      "x-displayName": "Изменение электронной почты для получения чеков",
      "description": "<div align=center><a href='images/adm-payer-email-change.svg' target='_blank'><img src='images/adm-payer-email-change.svg' width='600'></a></div>\n"
    }
  ],
  "paths": {
    "/v1/codes": {
      "get": {
        "summary": "Получение списка выпущенных кодов",
        "x-raif-api-summary-en": "Get list of released codes",
        "description": "Возвращает список выпущенных кодов внесения АДМ с возможностью фильтрации по:\n- идентификаторам компаний (cnum)\n- доступности кода (активные/заблокированные)\nПоддерживает пагинацию через параметры `offset` и `limit`.\n",
        "x-raif-api-description-en": "Returns a list of released ADM codes with filtering options:\n- by company identifiers (cnum)\n- by code availability (active/blocked)\nSupports pagination via `offset` and `limit` parameters.\n",
        "x-raif-api-service": "system",
        "operationId": "getCodeList",
        "parameters": [
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/CnumsQuery"
          },
          {
            "$ref": "#/components/parameters/FullNameQuery"
          },
          {
            "$ref": "#/components/parameters/AvailableFilter"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCodeListResponse"
                },
                "examples": {
                  "Список кодов": {
                    "$ref": "#/components/examples/CodeListResponseExample"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос",
            "x-raif-api-description-en": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestErrorResponse"
                },
                "examples": {
                  "Ошибка валидации": {
                    "$ref": "#/components/examples/BadRequestErrorExample"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "x-raif-api-description-en": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                },
                "examples": {
                  "Внутренняя ошибка": {
                    "$ref": "#/components/examples/InternalServerErrorExample"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/code-deactivations": {
      "post": {
        "summary": "(Черновик) Заявка на блокировку кода внесения",
        "x-raif-api-summary-en": "(Draft) Application for deactivation of the deposit code",
        "description": "Позволяет создать заявку на деактивацию кода внесения.\nИспользование данного API предполагает подписание в личном кабинете RBO.\n",
        "x-raif-api-description-en": "Allows you to create a request to deactivate a deposit code.\nUsing this API requires signing with the RBO.\n",
        "x-raif-api-service": "system",
        "tags": [
          "code-blocking"
        ],
        "operationId": "deactivateCode",
        "requestBody": {
          "description": "Заявка для создания",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeactivateCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeactivateCodeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос",
            "x-raif-api-description-en": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestErrorResponse"
                },
                "examples": {
                  "Ошибка валидации": {
                    "$ref": "#/components/examples/BadRequestErrorExample"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Доступ запрещён. Операция по блокировке кода недоступна.",
            "x-raif-api-description-en": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenErrorResponse"
                },
                "examples": {
                  "Доступ запрещён": {
                    "$ref": "#/components/examples/ForbiddenErrorExample"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "x-raif-api-description-en": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                },
                "examples": {
                  "Внутренняя ошибка": {
                    "$ref": "#/components/examples/InternalServerErrorExample"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/codes/{id}": {
      "get": {
        "summary": "Получение детальной информации о коде",
        "x-raif-api-summary-en": "Get detailed information about the code",
        "description": "Возвращает полную информацию о конкретном коде внесения АДМ по его идентификатору\n",
        "x-raif-api-description-en": "Returns full information about a specific ADM code by its identifier\n",
        "x-raif-api-service": "system",
        "operationId": "getCodeDetails",
        "parameters": [
          {
            "$ref": "#/components/parameters/CodeId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Code"
                },
                "examples": {
                  "Детальная информация о коде": {
                    "$ref": "#/components/examples/CodeDetailsResponseExample"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос",
            "x-raif-api-description-en": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestErrorResponse"
                },
                "examples": {
                  "Ошибка валидации": {
                    "$ref": "#/components/examples/BadRequestErrorExample"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не найден",
            "x-raif-api-description-en": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundErrorResponse"
                },
                "examples": {
                  "Ресурс не найден": {
                    "$ref": "#/components/examples/NotFoundErrorExample"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "x-raif-api-description-en": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                },
                "examples": {
                  "Внутренняя ошибка": {
                    "$ref": "#/components/examples/InternalServerErrorExample"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "payer-email-change"
        ],
        "summary": "Изменение параметров кода",
        "x-raif-api-summary-en": "Update code fields",
        "x-raif-api-service": "system",
        "description": "Выполняет операции изменения email плательщика.\n\nПоддерживаемые поля для обновления:\n  - `email` — email плательщика (необходима для отправки электронных чеков)\n\nМетод выполняет частичное обновление ресурса в стиле JSON Merge Patch.\n",
        "x-raif-api-description-en": "Method allows to update fields using JSON Merge Patch:\n- `email` — payer email (needed to send electronic checks)\n",
        "operationId": "updateCode",
        "parameters": [
          {
            "$ref": "#/components/parameters/CodeId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCodeRequest"
              },
              "examples": {
                "Обновление email": {
                  "$ref": "#/components/examples/UpdateCodeRequestExample"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Code"
                },
                "examples": {
                  "Код обновлён": {
                    "$ref": "#/components/examples/CodeDetailsResponseExample"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос",
            "x-raif-api-description-en": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestErrorResponse"
                },
                "examples": {
                  "Ошибка валидации": {
                    "$ref": "#/components/examples/BadRequestErrorExample"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не найден",
            "x-raif-api-description-en": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundErrorResponse"
                },
                "examples": {
                  "Ресурс не найден": {
                    "$ref": "#/components/examples/NotFoundErrorExample"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервера",
            "x-raif-api-description-en": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                },
                "examples": {
                  "Внутренняя ошибка": {
                    "$ref": "#/components/examples/InternalServerErrorExample"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Offset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "description": "Смещение от начала списка",
        "x-raif-api-description-en": "Offset from the start of the list",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "example": 0
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Максимальное количество возвращаемых записей",
        "x-raif-api-description-en": "Maximum number of items",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "example": 35
        }
      },
      "CnumsQuery": {
        "name": "cnums",
        "in": "query",
        "required": false,
        "description": "Фильтр по идентификаторам компаний в банке (cnum)",
        "x-raif-api-description-en": "Filter by company number (cnum)",
        "explode": false,
        "style": "form",
        "schema": {
          "type": "string",
          "example": "123456,111WWW"
        }
      },
      "FullNameQuery": {
        "name": "fullname",
        "in": "query",
        "required": false,
        "description": "Фильтр по полному имени плательщика. Может содержать фамилию, имя и отчество (частично или полностью).\n",
        "x-raif-api-description-en": "Filter by payer's full name. Can contain last name, first name, and patronymic (partially or completely).\n",
        "schema": {
          "type": "string",
          "example": "Иванов Иван Иванович"
        }
      },
      "AvailableFilter": {
        "name": "available",
        "in": "query",
        "required": false,
        "description": "Фильтр доступности кода (`true` — активные, `false` — заблокированные)",
        "x-raif-api-description-en": "Code availability filter ('true'- active, 'false' - blocked)",
        "schema": {
          "type": "boolean",
          "example": true
        }
      },
      "CodeId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Идентификатор кода",
        "x-raif-api-description-en": "Code id",
        "schema": {
          "type": "string",
          "example": "78901211"
        }
      }
    },
    "schemas": {
      "Customer": {
        "type": "object",
        "required": [
          "cnum",
          "name",
          "inn"
        ],
        "properties": {
          "cnum": {
            "type": "string",
            "description": "Клиентский номер компании",
            "x-raif-api-description-en": "Company cnum",
            "example": "123456"
          },
          "name": {
            "type": "string",
            "description": "Наименование компании",
            "x-raif-api-description-en": "Company name",
            "example": "Тестовая компания"
          },
          "inn": {
            "type": "string",
            "description": "ИНН компании",
            "x-raif-api-description-en": "Company INN",
            "pattern": "^[0-9]{10}$|^$",
            "example": "7701000001"
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "surname",
          "name",
          "birthDate",
          "cnum"
        ],
        "properties": {
          "surname": {
            "type": "string",
            "description": "Фамилия",
            "x-raif-api-description-en": "Last name",
            "example": "Иванов"
          },
          "name": {
            "type": "string",
            "description": "Имя",
            "x-raif-api-description-en": "Name",
            "example": "Иван"
          },
          "patronymic": {
            "type": "string",
            "description": "Отчество",
            "x-raif-api-description-en": "Patronymic",
            "example": "Иванович"
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "description": "Дата рождения",
            "x-raif-api-description-en": "Birth date",
            "example": "2007-07-04"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "description": "Email плательщика",
            "x-raif-api-description-en": "Payer email",
            "example": "test@test.ru"
          },
          "cnum": {
            "type": "string",
            "description": "Клиентский номер плательщика",
            "x-raif-api-description-en": "Payer cnum",
            "example": "ADWCF1"
          }
        }
      },
      "Code": {
        "type": "object",
        "required": [
          "id",
          "available",
          "createDate",
          "updateDate",
          "customer",
          "person"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор кода",
            "x-raif-api-description-en": "Code id",
            "example": "12345678"
          },
          "available": {
            "type": "boolean",
            "description": "Доступен ли код",
            "x-raif-api-description-en": "Code availability",
            "example": true
          },
          "createDate": {
            "type": "string",
            "format": "date-time",
            "description": "Дата создания записи",
            "x-raif-api-description-en": "Creation date",
            "example": "2025-07-16T08:29:31.93956Z"
          },
          "updateDate": {
            "type": "string",
            "format": "date-time",
            "description": "Дата последнего обновления",
            "x-raif-api-description-en": "Update date",
            "example": "2025-07-31T19:13:15.331124Z"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "person": {
            "$ref": "#/components/schemas/Person"
          }
        }
      },
      "DeactivateCodeRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "2873654434",
            "description": "Код внесения"
          }
        }
      },
      "DeactivateCodeResponse": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "6f6cd181-13dc-4736-b944-6d9da53f45a3",
            "description": "Идентификатор заявки"
          }
        }
      },
      "GetCodeListResponse": {
        "type": "object",
        "required": [
          "data",
          "offset",
          "limit",
          "totalCount"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Code"
            }
          },
          "offset": {
            "type": "integer",
            "description": "Смещение от начала списка",
            "x-raif-api-description-en": "Offset from the start of the list",
            "example": 0
          },
          "limit": {
            "type": "integer",
            "description": "Максимальное количество возвращаемых записей",
            "x-raif-api-description-en": "Maximum number of items",
            "example": 35
          },
          "totalCount": {
            "type": "integer",
            "description": "Общее количество записей",
            "x-raif-api-description-en": "The total number of items",
            "example": 35
          }
        }
      },
      "UpdateCodeRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "description": "Новый email плательщика",
            "x-raif-api-description-en": "New payer email",
            "example": "newemail@client.com"
          }
        },
        "example": {
          "email": "newemail@client.com"
        }
      },
      "BadRequestErrorResponse": {
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_DATA"
          },
          "message": {
            "type": "string",
            "example": "The request contains invalid fields or values"
          },
          "traceId": {
            "type": "string",
            "example": "84b19a21e19410b62c30b4cd40c228a1"
          }
        }
      },
      "NotFoundErrorResponse": {
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "RESOURCE_NOT_FOUND"
          },
          "message": {
            "type": "string",
            "example": "The resource not found"
          },
          "traceId": {
            "type": "string",
            "example": "84b19a21e19410b62c30b4cd40c228a1"
          }
        }
      },
      "ForbiddenErrorResponse": {
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "FORBIDDEN"
          },
          "message": {
            "type": "string",
            "example": "Setting available=true is not allowed. Code unblocking is disabled."
          },
          "traceId": {
            "type": "string",
            "example": "84b19a21e19410b62c30b4cd40c228a1"
          }
        }
      },
      "InternalServerError": {
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INTERNAL_ERROR"
          },
          "message": {
            "type": "string",
            "example": "An internal error occurred"
          },
          "traceId": {
            "type": "string",
            "example": "84b19a21e19410b62c30b4cd40c228a1"
          }
        }
      }
    },
    "examples": {
      "CodeListResponseExample": {
        "summary": "Пример списка выпущенных кодов",
        "value": {
          "data": [
            {
              "id": "12345678",
              "available": true,
              "createDate": "2025-07-16T08:29:31.93956Z",
              "updateDate": "2025-07-31T19:13:15.331124Z",
              "customer": {
                "cnum": "123456",
                "name": "Тестовая компания",
                "inn": "7701000001"
              },
              "person": {
                "surname": "Иванов",
                "name": "Иван",
                "patronymic": "Иванович",
                "birthDate": "2007-07-04",
                "email": "test@test.ru",
                "cnum": "ADWCF1"
